# ─────────────────────────────────────────────────────────────────
# FreshDS — Environment variables
# Copy to .env.local for local dev, set in Vercel dashboard for prod
# ─────────────────────────────────────────────────────────────────

# Supabase — project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe — dashboard → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — dashboard → Products → your $1 product → price ID
STRIPE_PRICE_ID=price_...

# Your production domain (no trailing slash)
SITE_URL=https://freshdesign.com
