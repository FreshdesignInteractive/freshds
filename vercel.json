{
  "functions": {
    "api/create-checkout.js": { "maxDuration": 30 },
    "api/stripe-webhook.js":  { "maxDuration": 30 },
    "api/export.js":          { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/about.html",   "destination": "/site/about.html",   "permanent": true },
    { "source": "/contact.html", "destination": "/site/contact.html", "permanent": true },
    { "source": "/privacy.html", "destination": "/site/privacy.html", "permanent": true },
    { "source": "/terms.html",   "destination": "/site/terms.html",   "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
